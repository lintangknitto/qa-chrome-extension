{
  "manifest_version": 3,
  "name": "Knitto QA Tools",
  "version": "0.4.0",
  "description": "Knitto QA Tools — koneksi browser ke recorder QA, AI agents via Knitto QA MCP, dan asistensi pengujian.",
  "permissions": [
    "debugger",
    "activeTab",
    "tabs",
    "tabGroups",
    "tabCapture",
    "offscreen",
    "storage",
    "browsingData",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "lib/background.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Knitto QA Tools",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["lib/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
